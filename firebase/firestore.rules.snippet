// Tempel di dalam blok `match /databases/{database}/documents { ... }`
// pada Firestore Rules project harmoni-indonesia (jangan hapus rules yang sudah ada).

function lkBolehAkses() {
  let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
  return u.get('aktif', false) == true
    && (u.get('role', '') == 'owner'
        || u.get('apps', {}).get('laporan_keuangan', {}).get('akses', false) == true);
}

// Semua data Laporan Keuangan memakai koleksi berprefix lk_
match /{koleksi}/{docId} {
  allow read, write: if koleksi.matches('lk_.*')
    && request.auth != null
    && lkBolehAkses();
}
