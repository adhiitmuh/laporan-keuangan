// Tempel di dalam blok `match /b/{bucket}/o { ... }`
// pada Storage Rules project harmoni-indonesia (jangan hapus rules yang sudah ada).

match /nota-pembelian/{file} { allow read, write: if request.auth != null; }
match /bukti-transfer/{file} { allow read, write: if request.auth != null; }
match /po-photos/{file}      { allow read, write: if request.auth != null; }
